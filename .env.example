# LLM — swap provider by changing these two lines
LLM_PROVIDER=groq                      # groq | google | openai | ollama
LLM_MODEL=llama-3.3-70b-versatile      # model name for the chosen provider
LLM_API_KEY=your_api_key_here           # not needed for ollama
LLM_BASE_URL=                           # only needed for ollama (e.g. http://localhost:11434/v1)

# Splunk
SPLUNK_HOST=localhost
SPLUNK_MCP_PORT=8089
SPLUNK_MCP_TOKEN=your_encrypted_mcp_token_here
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_TOKEN=your_hec_token_here
SPLUNK_VERIFY_SSL=false
