# ChainGuard Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === LLM Configuration ===
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Provider: "groq" or "openai"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# === Splunk MCP Configuration ===
# MCP server URL (from Splunk App for MCP)
SPLUNK_MCP_URL=https://localhost:8089/services/mcp

# MCP authentication token (generate in Splunk: Settings > MCP > Tokens)
SPLUNK_MCP_TOKEN=your_mcp_token_here

# === Splunk HEC Configuration ===
# Used for ingesting synthetic attack data
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=chainguard-hec-token
